#!/usr/bin/env node
// A stand-in `bynk` for the extension's CLI-driving tests (#2094). Point the
// `bynk.bynkPath` setting at this file. It never touches Cloudflare, wrangler or
// the network: each command prints a canned answer in the driver's own format.
//
// Every invocation appends `{ argv, cwd }` to `$BYNK_FAKE_LOG` (when set), a
// signal it receives appends `{ signal }`, and its exit appends `{ exit }`, so a
// test can assert exactly what the extension ran and how it stopped it. Each
// entry carries the `pid`, for a test that checks no process was left behind.

const fs = require("fs");
const net = require("net");

const log = process.env.BYNK_FAKE_LOG;
const record = (entry) => {
  if (log) fs.appendFileSync(log, JSON.stringify({ ...entry, pid: process.pid }) + "\n");
};
process.on("exit", (code) => record({ exit: code }));

const args = process.argv.slice(2);
record({ argv: args, cwd: process.cwd() });

if (args[0] === "book") {
  // `bynk book --search <query>`: a canned answer in the driver's own format.
  // `BYNK_FAKE_BOOK=none` is a `bynk` built without the Book bundle.
  if (process.env.BYNK_FAKE_BOOK === "none") {
    process.stderr.write("error: no Book bundled in this build of `bynk`.\n");
    process.exit(1);
  }
  const query = args.find((a) => a.startsWith("--search=")).slice("--search=".length);
  process.stdout.write(
    `# Bynk Book: 1 result(s) for "${query}"\n\n` +
      "Source: the Bynk Book v9.9.9, from the installed toolchain.\n\n" +
      "**1. Types › Refined types** — https://bynk-lang.org/book/reference/types/\n\n" +
      "A refined type adds a `where` predicate (fake bundle v9.9.9).\n",
  );
  process.exit(0);
} else if (args[0] === "dev") {
  // `bynk dev --format json`: listen on a free port (so the controller's
  // readiness probe succeeds), report it in a `serving` event, then serve until
  // stopped, as the real driver does.
  // A child that outlives its parent unless the whole process group is stopped,
  // as wrangler's workers do; its pid is logged so a test can check it is gone.
  const sleeper = require("child_process").spawn("sleep", ["300"], { stdio: "ignore" });
  sleeper.unref();
  record({ grandchild: sleeper.pid });
  // `BYNK_FAKE_DEV=http` (#67): serve HTTP, answering each request with what
  // it received (method, path, headers, body) as JSON, under the context name
  // `BYNK_FAKE_DEV_CONTEXT` (so a Send Request test can match its unit).
  const server =
    process.env.BYNK_FAKE_DEV === "http"
      ? require("http").createServer((req, res) => {
          let body = "";
          req.on("data", (chunk) => (body += chunk));
          req.on("end", () => {
            res.writeHead(201, { "content-type": "application/json", "x-fake": "echo" });
            res.end(JSON.stringify({ method: req.method, url: req.url, headers: req.headers, body }));
          });
        })
      : net.createServer((socket) => socket.end());
  server.listen(0, "127.0.0.1", () => {
    const port = server.address().port;
    const name = process.env.BYNK_FAKE_DEV_CONTEXT || "fixture";
    process.stderr.write("fake bynk dev: serving 1 context.\n");
    process.stdout.write(
      JSON.stringify({
        event: "serving",
        contexts: [{ name, port, url: `http://localhost:${port}`, inspector_port: null }],
      }) + "\n",
    );
 
    // `BYNK_FAKE_DEV=logs` (#2474): what `--log-events` reports for a handler
    // that throws, the frames already at `.bynk` as the driver rewrites them.
    if (process.env.BYNK_FAKE_DEV === "logs" && args.includes("--log-events")) {
      const log = (context, level, text) =>
        process.stdout.write(JSON.stringify({ event: "log", context, level, text }) + "\n");
      setTimeout(() => {
        log("fixture", "info", "GET / 500 Internal Server Error (4ms)");
        log("fixture", "error", "Error: boom");
        log("fixture", "error", "    at http_GET (/work/src/shop.bynk:12:3)");
        log("other", "warn", "▲ [WARNING] slow handler");
      }, 500);
    }

    // `BYNK_FAKE_DEV=rebuilds`: a failing rebuild, then a good one, as a save
    // that breaks a file and a save that fixes it would produce.
    if (process.env.BYNK_FAKE_DEV === "rebuilds") {
      const emit = (event) => process.stdout.write(JSON.stringify({ event }) + "\n");
      setTimeout(() => (emit("rebuilding"), emit("rebuild_failed")), 1000);
      setTimeout(() => (emit("rebuilding"), emit("rebuild_ok")), 5000);
    }
  });
  const stop = (signal, code) => {
    record({ signal });
    process.stdout.write(JSON.stringify({ event: "stopped", code }) + "\n");
    server.close();
    process.exit(code);
  };
  process.on("SIGTERM", () => stop("SIGTERM", 143));
  process.on("SIGINT", () => stop("SIGINT", 130));
} else if (args[0] === "openapi") {
  // `bynk openapi <root> --out <file>`: writes a stub document to `--out`.
  const out = args.indexOf("--out");
  if (out < 0 || !args[out + 1]) {
    process.stderr.write("fake bynk: openapi needs --out <file>\n");
    process.exit(2);
  }
  fs.writeFileSync(args[out + 1], '{"openapi":"3.1.0","info":{"title":"fake","version":"0"}}\n');
  process.exit(0);
} else if (args[0] === "deploy") {
  if (args.includes("--dry-run") && args.includes("json")) {
    // The pinned plan the extension's unit tests read, as the dry run prints it.
    process.stdout.write(fs.readFileSync(require("path").join(__dirname, "..", "deploy-plan.json"), "utf8"));
    process.exit(0);
  }
  // A real deploy is never something a test may run.
  process.stderr.write("fake bynk: refusing a real deploy in tests\n");
  process.exit(3);
} else if (args[0] === "tail") {
  // `bynk tail --help` is the extension's probe that the driver has `tail`; a real
  // tail would stream a deployed Worker's logs, so here it only prints a line.
  process.stdout.write(args.includes("--help") ? "Usage: bynk tail --env <ENV>\n" : "fake bynk tail: no Worker in tests\n");
  process.exit(0);
} else if (args[0] === "migrate") {
  // `bynk migrate status --format json`: the pinned report. `BYNK_FAKE_MIGRATE=errors`
  // refuses as a project with errors does. A sweep is never something a test may run.
  if (args[1] === "status") {
    if (process.env.BYNK_FAKE_MIGRATE === "errors") {
      process.stderr.write("bynk migrate status: the project has errors; fix them first (`bynk check`)\n");
      process.exit(1);
    }
    process.stdout.write(fs.readFileSync(require("path").join(__dirname, "..", "migrate-status.json"), "utf8"));
    process.exit(0);
  }
  process.stderr.write("fake bynk: refusing a real sweep in tests\n");
  process.exit(3);
} else if (args[0] === "doctor") {
  // The driver's own golden report (bynk/tests/golden/doctor.json in the
  // compiler repository), copied beside this directory.
  const golden = require("path").join(__dirname, "..", "doctor.golden.json");
  process.stdout.write(fs.readFileSync(golden, "utf8"));
  process.exit(args.includes("--only") ? 1 : 0);
} else if (args[0] === "test" && (args.includes("json") || args.includes("ndjson"))) {
  // `bynk test --format json`: the pinned coverage document, which also lists
  // one suite. Discovery (`--no-run`) and a plain run carry no coverage block.
  // `--format ndjson` is the same run as the driver's event stream (#2267):
  // `BYNK_FAKE_NDJSON=unsupported` makes it refuse the value as a driver that
  // predates the stream does, and `BYNK_FAKE_STREAM_DELAY_MS` waits that long after
  // each case, so a test can see a case arrive before the run has ended.
  //
  // `BYNK_FAKE_TEST_DOC=<path>` serves that document instead, so a test can shape
  // the tree. Like the real driver, a run keeps every suite but only the cases
  // named by `--case` (an empty suite stays, with no cases), and discovery
  // ignores `--case` and marks every case "discovered".
  const stream = args.includes("ndjson");
  if (stream && process.env.BYNK_FAKE_NDJSON === "unsupported") {
    process.stderr.write(
      "error: invalid value 'ndjson' for '--format <FORMAT>'\n  [possible values: rich, json]\n",
    );
    process.exit(2);
  }
  // The document, or its events as the driver writes them.
  const events = (doc) => {
    if (!doc.suites) return doc.error ? [{ type: "error", ...doc.error }] : [];
    const out = [{ type: "run-begin", suites: doc.suites.length }];
    for (const s of doc.suites) {
      out.push({ type: "suite-begin", name: s.name, kind: s.kind, tests: s.cases.length });
      for (const c of s.cases) if (c.outcome !== "skipped") out.push({ type: "case", suite: s.name, ...c });
      out.push({ type: "suite-end", name: s.name });
    }
    for (const s of doc.suites) {
      for (const c of s.cases) if (c.outcome === "skipped") out.push({ type: "case", suite: s.name, ...c });
    }
    if (doc.error) out.push({ type: "error", ...doc.error });
    else {
      const end = { type: "run-end", passed: doc.passed, failed: doc.failed };
      if (doc.skipped) end.skipped = doc.skipped;
      if (doc.transport) end.transport = doc.transport;
      out.push(end);
    }
    return out;
  };
  const emit = async (doc, code) => {
    if (!stream) {
      process.stdout.write(JSON.stringify(doc, null, 2) + "\n");
    } else {
      const delay = Number(process.env.BYNK_FAKE_STREAM_DELAY_MS || 0);
      for (const event of events(doc)) {
        process.stdout.write(JSON.stringify(event) + "\n");
        if (delay && event.type === "case") await new Promise((r) => setTimeout(r, delay));
      }
    }
    process.exit(code);
  };
  // A run the extension cancels is killed: record it, as the `dev` branch does.
  process.on("SIGTERM", () => {
    record({ signal: "SIGTERM" });
    process.exit(143);
  });
  const docPath = process.env.BYNK_FAKE_TEST_DOC;
  const doc = JSON.parse(
    fs.readFileSync(docPath || require("path").join(__dirname, "..", "test-coverage.json"), "utf8"),
  );
  if (args.includes("--no-run")) {
    for (const s of doc.suites) for (const c of s.cases) c.outcome = "discovered";
  } else {
    // A set (#2273): `--suite` and `--case` each repeat, their values combine as
    // "or", and the two combine as "and". An unselected suite is omitted; a suite
    // none of whose cases match stays, empty, as the real driver keeps it.
    const values = (flag) => args.flatMap((a, i) => (a === flag ? [args[i + 1]] : []));
    const suites = values("--suite");
    const cases = values("--case");
    if (process.env.BYNK_FAKE_SETS === "unsupported" && (suites.length > 0 || cases.length > 1)) {
      // A driver that predates the set filter: clap rejects the second `--case`
      // and does not know `--suite`.
      process.stderr.write(
        suites.length > 0
          ? "error: unexpected argument '--suite' found\n"
          : "error: the argument '--case <NAME>' cannot be used multiple times\n",
      );
      process.exit(2);
    }
    if (suites.length > 0) doc.suites = doc.suites.filter((s) => suites.includes(s.name));
    if (cases.length > 0) for (const s of doc.suites) s.cases = s.cases.filter((c) => cases.includes(c.name));
  }
  if (!args.includes("--coverage")) delete doc.coverage;
  if (args.includes("--against") && !args.includes("--no-run")) {
    // `--against <target>`: only the `system` cases run, the document names its
    // transport, and `BYNK_FAKE_AGAINST` makes the driver refuse as it would:
    // `unsupported` is the compile-time refusal `--skip-unsupported` lifts,
    // `refused` is a runtime refusal (an unsafe target, say).
    const target = args[args.indexOf("--against") + 1];
    const mode = process.env.BYNK_FAKE_AGAINST;
    if (mode === "unsupported" && !args.includes("--skip-unsupported")) {
      return emit(
        {
          passed: 0,
          failed: 0,
          error: {
            kind: "compile",
            diagnostics: [
              "src/text.bynk:1:1: error[T0412]: case `wired one` uses `advance Clock`; run it in process, or pass `--skip-unsupported` to skip it with this reason",
            ],
          },
        },
        1,
      );
    }
    if (mode === "refused") {
      return emit(
        {
          passed: 0,
          failed: 0,
          error: { kind: "runtime", message: `target \`${target}\` is marked \`production = true\`; the test runner never runs against production` },
        },
        1,
      );
    }
    for (const s of doc.suites) s.cases = s.cases.filter((c) => c.tier === "system");
    doc.suites = doc.suites.filter((s) => s.cases.length > 0);
    doc.transport = `remote:${target}`;
  }
  emit(doc, 0);
} else if (args[0] === "test" && args.includes("--inspect")) {
  // `bynk test --inspect`: there is no inspector here. A driver that predates the set
  // filter rejects one as clap does (`BYNK_FAKE_SETS=unsupported`); anything else
  // exits, which a debug launch reports as a process that never became ready.
  // `BYNK_FAKE_CHATTY=1` (#30): a debuggee that writes far more than a pipe holds
  // (about 64 KB) to stdout and stderr before it exits. It blocks on the write
  // until the extension reads, so it only gets to exit 0 if its output is drained.
  if (process.env.BYNK_FAKE_CHATTY) {
    // Half before the ready line, which the reader is waiting on, and half after
    // it, when that wait is over and only the session's drain is left to read.
    const line = "x".repeat(1023) + "\n";
    const burst = () => {
      for (let i = 0; i < 128; i++) {
        process.stdout.write(line);
        process.stderr.write(line);
      }
    };
    burst();
    process.stderr.write("Debugger listening on ws://127.0.0.1:9229/fake\n");
    burst();
    // Not `process.exit`: that would drop writes still queued behind a full pipe,
    // and the point is that they are not dropped but waited on.
    process.exitCode = 0;
    return;
  }
  const isSet = args.includes("--suite") || args.filter((a) => a === "--case").length > 1;
  if (process.env.BYNK_FAKE_SETS === "unsupported" && isSet) {
    process.stderr.write("error: unexpected argument '--suite' found\n");
    process.exit(2);
  }
  process.stderr.write("fake bynk: no inspector in tests\n");
  process.exit(3);
} else if (args[0] === "deps" && process.env.BYNK_FAKE_DEPS) {
  // `bynk deps --format json` (#2472): the document `BYNK_FAKE_DEPS` names.
  process.stdout.write(fs.readFileSync(process.env.BYNK_FAKE_DEPS, "utf8"));
  process.exit(0);
} else if (args[0] === "search") {
  // `bynk search <package> --format json` (#2472): `acme/money` has 0.3.1, 0.4.0
  // and a yanked 0.5.0; any other package is unknown. `BYNK_FAKE_SEARCH=offline`
  // is a registry that cannot be reached.
  if (process.env.BYNK_FAKE_SEARCH === "offline") {
    process.stderr.write("error[bynk.registry.unavailable]: registry `acme-internal` could not be reached\n");
    process.exit(1);
  }
  if (args[1] !== "acme/money") {
    process.stderr.write(`error[bynk.registry.unavailable]: registry \`acme-internal\` has no package \`${args[1]}\`\n`);
    process.exit(1);
  }
  const version = (v, yanked) => ({ version: v, checksum: `sha256-${v}`, yanked, withdrawn: null });
  process.stdout.write(
    JSON.stringify({
      package: "acme/money",
      registry: "acme-internal",
      latest: "0.4.0",
      versions: [version("0.3.1", false), version("0.4.0", false), version("0.5.0", true)],
    }) + "\n",
  );
  process.exit(0);
} else if (args[0] === "add") {
  // `bynk add <package>[@range] --format json` (#2472).
  const [pkg, range] = args[1].split("@");
  process.stdout.write(
    JSON.stringify({ added: { alias: pkg.split("/")[1], package: pkg, version: range ?? "^0.4.0" } }) + "\n",
  );
  process.exit(0);
} else if (args[0] === "fetch") {
  // `bynk fetch --format json` (#2472).
  process.stdout.write(
    JSON.stringify({ wrote_lock: true, fetched: [], warnings: [], pending_npm: [] }) + "\n",
  );
  process.exit(0);
} else if (args[0] === "publish") {
  // `bynk publish [--dry-run] --format json` (#2472). A "real" publish only
  // prints the document: nothing leaves the machine.
  if (process.env.BYNK_FAKE_PUBLISH === "refused") {
    process.stderr.write("error[bynk.registry.publish_refused]: no token for `acme`\n");
    process.exit(1);
  }
  process.stdout.write(
    JSON.stringify({
      package: "acme/fixture",
      version: "0.1.0",
      checksum: "sha256-fixture",
      registry: "acme-internal",
      dry_run: args.includes("--dry-run"),
      files: [
        { path: "bynk.toml", bytes: 120 },
        { path: "src/main.bynk", bytes: 2048 },
      ],
    }) + "\n",
  );
} else if (args[0] === "approve") {
  // `bynk approve --list --format json` (#2473): the pinned listing, with each
  // package an earlier `approve <package>` / `--all` of this run approved
  // marked so. The approvals live beside `$BYNK_FAKE_LOG`.
  const path = require("path");
  const state = log ? log + ".approved" : undefined;
  const approved = state && fs.existsSync(state) ? JSON.parse(fs.readFileSync(state, "utf8")) : [];
  const doc = JSON.parse(fs.readFileSync(path.join(__dirname, "..", "approve-list.json"), "utf8"));
  if (args.includes("--list")) {
    for (const r of doc.requirements) {
      if (r.state === "pending" && approved.includes(r.package)) (r.state = "approved"), (r.change = null);
    }
    doc.pending = doc.requirements.filter((r) => r.state === "pending").length;
    process.stdout.write(JSON.stringify(doc, null, 2) + "\n");
    process.exit(0);
  }
  const names = args.includes("--all")
    ? doc.requirements.filter((r) => r.state === "pending").map((r) => r.package)
    : [args[1]];
  if (state) fs.writeFileSync(state, JSON.stringify([...approved, ...names]));
  process.stderr.write(`fake bynk: approved ${names.join(", ")}\n`);
  process.exit(0);
} else if (args[0] === "check") {
  // `bynk check . --format short`: a clean project, or under
  // `BYNK_FAKE_DEV=rebuilds` the error the failing rebuild reported.
  if (process.env.BYNK_FAKE_DEV === "rebuilds") {
    // `BYNK_FAKE_APPROVE=pending`: the compile also refuses an unapproved
    // npm requirement (#2473).
    if (process.env.BYNK_FAKE_APPROVE === "pending") {
      process.stderr.write(
        "src/text.bynk:1:1: error[bynk.requires.unapproved]: the adapter requires npm package `jose` at `^6.0.0`, which is not approved\n",
      );
    }
    process.stderr.write("src/text.bynk:1:1: error[bynk.fake.rebuild]: fake rebuild error\n");
    process.exit(1);
  }
  process.exit(0);
} else {
  process.stderr.write(`fake bynk: no canned answer for \`${args.join(" ")}\`\n`);
  process.exit(2);
}
